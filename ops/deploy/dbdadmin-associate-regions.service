# /etc/systemd/system/dbdadmin-associate-regions.service
# 安装:sudo cp ops/deploy/dbdadmin-associate-regions.service /etc/systemd/system/ && sudo systemctl daemon-reload
# 配套 .timer 见同目录,需一并安装 + enable --now dbdadmin-associate-regions.timer
#
# 体检发现:ops/associate_regions.sh 注释自称"由 systemd timer 周期调用",但仓库里从未有
# 对应的 timer/cron 单元——上线后若不补,新同步进来的公司不会被自动关联区域/行业分类。
[Unit]
Description=泰国企业区域+业务分类自动关联(幂等)
After=postgresql.service dbdadmin-woocms.service
Wants=postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/www/wwwroot/bizthai/dbd-thai
ExecStart=/www/wwwroot/bizthai/dbd-thai/ops/associate_regions.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
