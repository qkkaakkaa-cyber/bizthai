# /etc/systemd/system/dbdai.service
# 安装:sudo cp deploy/dbdai.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now dbdai
[Unit]
Description=DBD Thai AI 对话助手 (sidecar:DeepSeek 工具调用 over WooCMS/analytics/directors)
After=network.target dbdadmin-woocms.service dbdanalytics.service dbddirectors.service
Wants=dbdadmin-woocms.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/data/projects/dbd-thai/ai
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
# 日志(与其它 sidecar 同目录风格)
StandardOutput=append:/data/projects/dbd-thai/logs/dbdai.app.log
StandardError=append:/data/projects/dbd-thai/logs/dbdai.app-error.log

[Install]
WantedBy=multi-user.target
