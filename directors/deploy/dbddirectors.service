# /etc/systemd/system/dbddirectors.service
# 安装:sudo cp deploy/dbddirectors.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now dbddirectors
[Unit]
Description=DBD Thai 董事按证件号反查服务 (sidecar over woocms.director_index)
After=network.target postgresql.service dbdadmin-woocms.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/data/projects/dbd-thai/directors
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
StandardOutput=append:/data/projects/dbd-thai/logs/dbddirectors.app.log
StandardError=append:/data/projects/dbd-thai/logs/dbddirectors.app-error.log

[Install]
WantedBy=multi-user.target
