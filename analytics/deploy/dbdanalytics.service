# /etc/systemd/system/dbdanalytics.service
# 安装:sudo cp deploy/dbdanalytics.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now dbdanalytics
[Unit]
Description=DBD Thai 商业环境分析聚合服务 (sidecar over WooCMS)
After=network.target dbdadmin-woocms.service
Wants=dbdadmin-woocms.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/data/projects/dbd-thai/analytics
# 体检发现:docker-compose.yml 本地环境把 REFRESH_MS 缩到 10 分钟(原 762k 陈旧数据事故的修复),
# 但这份生产 systemd unit 之前没有对应设置,会退回代码默认值——补上保持两边行为一致。
Environment=REFRESH_MS=600000
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
# 日志(与 dbdadmin 同目录风格)
StandardOutput=append:/data/projects/dbd-thai/logs/dbdanalytics.app.log
StandardError=append:/data/projects/dbd-thai/logs/dbdanalytics.app-error.log

[Install]
WantedBy=multi-user.target
