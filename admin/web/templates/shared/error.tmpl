{{ define "shared/error.tmpl" }}
<!doctype html>
<html lang="{{ .lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ .code }} - WooCMS</title>
  <script src="/assets/vendor/tailwindcss/tailwindcss.com.js"></script>
</head>
<body class="bg-gray-50 text-gray-800">
  <main class="mx-auto flex min-h-screen max-w-2xl items-center justify-center p-8">
    <div class="w-full rounded bg-white p-10 text-center shadow-sm">
      <p class="text-sm text-gray-500">{{ .label_error }}</p>
      <h1 class="mt-2 text-4xl font-bold">{{ .code }}</h1>
      <p class="mt-4 text-gray-600">{{ .message }}</p>
      <div class="mt-8">
        <a class="rounded bg-gray-900 px-4 py-2 text-white" href="/">{{ .label_home }}</a>
      </div>
    </div>
  </main>
</body>
</html>
{{ end }}
